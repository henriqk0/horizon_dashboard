  "codigo": "PJ 6497",
  "titulo": "Kit de Transformação Digital para prédios Inteligentes",
  "descricao": "Projeto que visa desenvolver um kit de transformação digital para prédios inteligentes, utilizando tecnologias como Internet das Coisas (IoT), visão computacional, reconhecimento e processamento de voz, além de inteligência artificial embarcada e computação de borda. O objetivo é integrar funcionalidades em edificações, otimizando custos operacionais, melhorando a segurança e a satisfação dos usuários.",
  "palavras_chave": [
    "Internet das Coisas (IoT)",
    "Visão Computacional",
    "Reconhecimento de Voz",
    "Inteligência Artificial (IA)",
    "Computação de Borda (Edge Computing)",
    "Edificações Inteligentes",
    "Automação Inteligente",
    "Serviços 4.0",
    "Sistemas Embarcados"
  ],
  "area_conhecimento": "Engenharia Elétrica e Computação",
  "linha_pesquisa": "Tecnologias Digitais Aplicadas a Edificações Inteligentes",
  "objetivos": {
    "geral": "Desenvolver o Kit de Transformação Digital para edifícios inteligentes, integrando tecnologias de IoT, IA e computação embarcada.",
    "especificos": [
      "Integração das funcionalidades desenvolvidas em laboratório com instrumentação típica de edificações (CFTV, interfones, iluminação).",
      "Obtenção da plataforma mínima de computação de borda para embarcar funcionalidades do sistema.",
      "Realização de casos de teste em edificações de diferentes tipos.",
      "Amadurecimento das funcionalidades de visão computacional, reconhecimento de voz e IA para aplicação em solução comercial."
    ]
  },
