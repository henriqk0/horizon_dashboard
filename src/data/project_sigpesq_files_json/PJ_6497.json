{
  "codigo": "PJ 6497",
  "titulo": "Kit de Transformação Digital para prédios Inteligentes",
  "descricao": "Projeto que visa desenvolver um kit de transformação digital para prédios inteligentes, utilizando tecnologias como Internet das Coisas (IoT), visão computacional (CV), reconhecimento e processamento de voz (VRecon), inteligência artificial (IA) e computação de borda (Edge Computing). O objetivo é integrar funcionalidades de automação e inteligência artificial em edificações, melhorando a eficiência operacional, segurança e satisfação dos usuários.",
  "palavras_chave": [
    "Internet das Coisas (IoT)",
    "Visão Computacional",
    "Reconhecimento de Voz",
    "Inteligência Artificial",
    "Computação de Borda",
    "Edificações Inteligentes",
    "Automação Predial",
    "Economia 4.0",
    "Serviços 4.0",
    "Edge Computing",
    "Sistemas Embarcados"
  ],
  "area_conhecimento": "Engenharia Elétrica e Computação",
  "linha_pesquisa": "Tecnologias Digitais Aplicadas a Edificações Inteligentes",
  "objetivos": {
    "geral": "Desenvolver o Kit de Transformação Digital para edifícios inteligentes, integrando tecnologias de IoT, IA e Edge Computing para melhorar a eficiência operacional, segurança e satisfação dos usuários em edificações.",
    "especificos": [
      "Integração das funcionalidades desenvolvidas em laboratório com instrumentação típica de edificações (CFTV, interfones, iluminação).",
      "Obtenção da plataforma mínima de computação de borda para embarcar funcionalidades do sistema.",
      "Realização de casos de teste em edificações de diferentes tipos.",
      "Amadurecimento das funcionalidades de Visão Computacional, Reconhecimento de Voz e IA para aplicação em solução comercial."
    ]
  },
