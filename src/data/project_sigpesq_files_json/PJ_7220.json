{
  "codigo": "PJ 7220",
  "titulo": "OTIMIZAÇÃO DA EFICIÊNCIA ENERGÉTICA DO USO DE GÁS NA SIDERURGIA USANDO NEURO-EVOLUÇÃO",
  "descricao": "Projeto visa investigar técnicas de neuro-evolução para a obtenção de modelos de redes neurais profundas para a predição de geração de gás de aciaria e consumo de gás em alto-forno, utilizando séries temporais multivariadas. O projeto busca otimizar a eficiência energética no uso de gás na siderurgia, reduzindo custos e emissões de CO₂, além de fortalecer a linha de pesquisa em inteligência artificial do grupo Nu[Tec]², promovendo divulgação científica, publicações e formação de jovens pesquisadores.",
  "palavras_chave": [
    "Séries Temporais multivariadas",
    "redes neurais profundas",
    "sustentabilidade na siderurgia",
    "neuro-evolução",
    "otimização energética",
    "inteligência artificial",
    "computação evolucionária"
  ],
  "area_conhecimento": "Ciência da Computação » Metodologia e Técnicas da Computação » Ciências Exatas e da Terra",
  "linha_pesquisa": "Inteligência Artificial e Otimização de Processos Industriais",
  "objetivos": {
    "geral": "Investigar técnicas de neuro-evolução para a obtenção de modelos de redes neurais profundas para a predição de geração de gás de aciaria e consumo de gás em alto-forno, visando otimizar a eficiência energética na siderurgia.",
    "especificos": [
      "Consolidação do grupo de pesquisa Nu[Tec]² através de publicações e divulgação científica.",
      "Fortalecimento da linha de pesquisa em inteligência artificial com registro de propriedade intelectual (software e transferência de tecnologia).",
      "Formação de jovens pesquisadores em diversos níveis (mestrado, graduação, iniciação científica e IC Jr).",
      "Promoção de atividades de extensão voltadas à divulgação científica, especialmente para meninas em áreas de exatas.",
      "Criação e manutenção de homepage e perfis em redes sociais para divulgação dos resultados da pesquisa."
    ]
  },
