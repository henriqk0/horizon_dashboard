{
  "codigo": "PJ 4911",
  "titulo": "Tecnologia vestível para alerta e vigilância de atmosfera perigosa",
  "descricao": "Projeto propõe o desenvolvimento de uma rede de sensores e componentes eletrônicos de baixo custo e baixo consumo energético embarcados nas vestimentas de proteção para bombeiros, utilizando tecnologias vestíveis (wearable technology) e Internet das Coisas (IoT) para monitorar gases tóxicos, explosivos, temperatura, pressão, umidade e biomarcadores dos profissionais em tempo real, visando garantir a segurança dos socorristas e vítimas em cenários de desastres.",
  "palavras_chave": [
    "Tecnologia vestível",
    "IoT",
    "detecção de gases"
  ],
  "area_conhecimento": "Engenharias » Engenharia Biomédica » Engenharia Médica » Transdutores para Aplicações Biomédicas",
  "linha_pesquisa": null,
  "objetivos": {
    "geral": "Desenvolver um protótipo de roupa robótica para bombeiros com tecnologias vestíveis embarcadas, capaz de detectar gases tóxicos, limites de explosividade, temperatura, pressão, umidade e biomarcadores do profissional, transmitindo os dados em tempo real para um centro de gerenciamento e controle.",
    "especificos": [
      "Promover a formação de recursos humanos na área de tecnologias vestíveis",
      "Contribuir com o desenvolvimento tecnológico de sistemas de robótica vestíveis",
      "Apresentar um protótipo de roupa robótica de combate a incêndios",
      "Escrita de patente relacionada ao protótipo desenvolvido"
    ]
  },
