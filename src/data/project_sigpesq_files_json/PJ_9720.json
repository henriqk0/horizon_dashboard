{
  "codigo": "PJ 9720",
  "titulo": "Inteligência Artificial para Monitoramento de Saúde Mental a partir da Análise de Face e Voz",
  "descricao": "Projeto propõe o desenvolvimento de modelos de Inteligência Artificial para monitoramento de saúde mental, com foco na identificação de sinais de ansiedade e depressão a partir da análise de face e voz, priorizando gestantes de alto risco.",
  "palavras_chave": [
    "Computação Afetiva",
    "Modelos de Fundação",
    "Inteligência Artificial",
    "Modelos de Visão e Linguagem",
    "Redes Neurais",
    "Saúde Mental",
    "Depressão",
    "Ansiedade",
    "Facial Action Units",
    "Selfies",
    "Análise de Voz",
    "Aprendizado de Máquina",
    "Fusão Multimodal"
  ],
  "area_conhecimento": "Ciência da Computação",
  "linha_pesquisa": "Visão Computacional e Aprendizado de Máquina",
  "objetivos": {
    "geral": "Desenvolver modelos de IA capazes de identificar sinais de ansiedade e depressão a partir da análise facial e de voz, com foco em pacientes gestantes de risco.",
    "especificos": [
      "Atualizar a bibliografia a partir de trabalhos relevantes na área.",
      "Ampliar a base de dados a partir de coletas realizadas pelo grupo médico do Inova E-pq armazenadas na Plataforma RedCap.",
      "Investigar modelos pré-treinados para descrever textualmente características emocionais de sinais de áudio (voz), integrando essas descrições às representações geradas por modelos de visão e linguagem.",
      "Empregar espectrogramas Mel para transformar sinais de áudio em representações visuais, integrando a modalidade de áudio em um framework único baseado em redes convolucionais.",
      "Investigar e implementar estratégias de aprendizado conjunto (ensemble) para combinar modelos convolucionais com modelos de análise de áudio.",
      "Orientar alunos de graduação e mestrado.",
      "Publicar 2 artigos em conferências especializadas e 2 artigos em periódicos (Qualis A1-A4)."
    ]
  },
