{
  "codigo": "PJ 5431",
  "titulo": "Núcleo Emergente em Redes Definidas por Software (NERDS)",
  "descricao": "Projeto de pesquisa e desenvolvimento para explorar o estado-da-arte e propor novos paradigmas que otimizem, de forma integrada e autonômica, a virtualização, programação, controle e gerenciamento de redes de ambientes de datacenters. O projeto visa desenvolver soluções para novas gerações de redes programáveis para datacenters, focando em topologias de interconexão, desempenho e flexibilidade do plano de dados, e orquestração e gerenciamento autonômico.",
  "palavras_chave": [
    "Redes Definidas por Software (SDN)",
    "Virtualização de Funções de Rede (NFV)",
    "Computação em Nuvem",
    "Datacenters",
    "Topologias de Interconexão",
    "Orquestração Autonômica",
    "Programabilidade de Redes",
    "Desempenho de Redes",
    "Segurança em Redes",
    "Internet das Coisas (IoT)"
  ],
  "area_conhecimento": "Engenharias",
  "linha_pesquisa": "Sistemas de Telecomunicações e Arquitetura de Sistemas de Computação",
  "objetivos": {
    "geral": "Explorar o estado-da-arte e avançar propondo novos paradigmas que possam otimizar, de forma integrada e autonômica, a virtualização, programação, controle e gerenciamento de redes de ambientes de datacenters.",
    "especificos": [
      "Analisar o estado da arte e as limitações da área de programabilidade de redes de datacenter.",
      "Propor novas soluções de programabilidade de redes de datacenter.",
      "Desenvolver protótipos como provas de conceito das soluções propostas.",
      "Avaliar os resultados das soluções desenvolvidas em testes parciais e de integração.",
      "Melhorar e ampliar a infraestrutura experimental para possibilitar a geração de protótipos e provas de conceito.",
      "Aumentar a formação e capacitação de recursos humanos.",
      "Fortalecer parcerias com outros grupos de pesquisa nacionais e internacionais.",
      "Fomentar a formação de outros núcleos nos campi do IFES.",
      "Aumentar significativamente a produção científica.",
      "Abrir linhas de parcerias com empresas para inovação.",
      "Gerar soluções tecnológicas abertas disponibilizadas à comunidade acadêmica."
    ]
  },
