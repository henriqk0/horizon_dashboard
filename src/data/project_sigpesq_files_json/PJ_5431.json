{
  "codigo": "PJ 5431",
  "titulo": "Núcleo Emergente em Redes Definidas por Software (NERDS)",
  "descricao": "O projeto visa desenvolver soluções para novas gerações de redes programáveis para datacenters que sejam capazes de tratar os problemas de: topologias para interconexão de servidores em redes de datacenters; desempenho e flexibilidade do plano de dados em redes de datacenters; e orquestração e gerenciamento na direção de datacenters autonômicos. O NERDS congrega um conjunto de habilitadores e competências para prover soluções econômicas, eficientes e programáveis para redes de datacenter voltadas à virtualização de funções de redes.",
  "palavras_chave": [
    "Redes Definidas por Software",
    "Computação em Nuvem",
    "Datacenters",
    "Virtualização de Funções de Rede (NFV)",
    "Programabilidade de Redes",
    "Orquestração",
    "Gerenciamento Autonômico"
  ],
  "area_conhecimento": "Engenharias",
  "linha_pesquisa": "3.04.06.03-0: Sistemas de Telecomunicações; 1.03.04.04-5: Teleinformática; 1.03.04.02-9: Arquitetura de Sistemas de Computação",
  "objetivos": {
    "geral": "Explorar o estado-da-arte e avançar propondo novos paradigmas que possam otimizar, de forma integrada e autonômica, a virtualização, a programação, o controle e o gerenciamento de redes de ambientes de datacenters.",
    "especificos": [
      "Analisar o estado da arte e as limitações da área de programabilidade de redes de datacenter.",
      "Propor novas soluções de programabilidade de redes de datacenter.",
      "Desenvolver protótipos como provas de conceito das soluções propostas.",
      "Avaliar os resultados das soluções desenvolvidas em testes parciais e de integração.",
      "Melhorar e ampliar a infraestrutura experimental para possibilitar a geração de protótipos e provas de conceito.",
      "Aumentar a formação e capacitação de recursos humanos.",
      "Fortalecer parcerias com outros grupos de pesquisa nacionais e internacionais.",
      "Aumentar significativamente a produção científica.",
      "Abrir linha de parcerias com empresas para inovação.",
      "Gerar soluções tecnológicas abertas disponibilizadas à comunidade acadêmica."
    ]
  },
