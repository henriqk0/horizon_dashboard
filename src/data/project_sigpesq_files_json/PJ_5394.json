{
  "codigo": "PJ 5394",
  "titulo": "SERVANT-ES: Sistema Experimental de Veículo Aéreo Não Tripulado para Pesquisa",
  "descricao": "Veículos Aéreos Não Tripulados (VANTs) e Veículos Aéreos Remotamente Pilotados (VARPs) têm se tornado mais importantes a cada dia. O projeto SERVANT-ES visa desenvolver uma plataforma software aberta e open source para a pesquisa com VANTs e VARPs utilizando técnicas modernas de engenharia para o desenvolvimento do hardware, e uma metodologia baseada na aplicação de métodos formais para projetar e analisar um sistema aviônico para controle de voo. Além disso, o sistema aviônico será gerado para fazer uso das informações do maior número possível de sensores que poderão ser “plugados” ou “desplugados” conforme a necessidade das pesquisas que venha a fazer uso da plataforma.",
  "palavras_chave": [
    "veículo aéreo não tripulado",
    "VANT",
    "sistemas de controle de voo",
    "aviônicos",
    "métodos formais",
    "model checking",
    "abstract interpretation"
  ],
  "area_conhecimento": "Ciências Exatas e da Terra",
  "linha_pesquisa": "Arquitetura de Sistemas de Computação; Computabilidade e Modelos de Computação; Sistemas Aeroespaciais",
  "objetivos": {
    "geral": "Desenvolver, através da aplicação de métodos formais, uma plataforma de software aberta, para pesquisa e desenvolvimento de aplicações de VANTs, que garanta segurança e funcionalidade.",
    "especificos": [
      "Desenvolvimento de novas técnicas de validação de modelos de sistemas de controle baseados em verificação de modelos",
      "Desenvolvimento de novas técnicas de validação de software de sistemas aviônicos utilizando interpretação abstrata de programas",
      "Criação de uma plataforma acessível de veículos aéreos não tripulados para pesquisadores e empreendedores"
    ]
  },
