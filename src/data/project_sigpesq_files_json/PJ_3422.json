  "linha_pesquisa": "Processamento Digital de Imagens e Reconhecimento de Padrões",
  "objetivos": {
    "geral": "Desenvolver sistemas e tecnologias inovadoras em processamento digital de imagens, reconhecimento de padrões e aplicações em visão computacional, visando contribuir para áreas como agricultura de precisão, segurança pública, saúde e tecnologias assistivas.",
    "especificos": [
      "Desenvolver um sistema de controle de um Veículo Aéreo Não Tripulado (VANT) para mapeamento de plantações de café.",
      "Criar um sistema de vídeo monitoramento para identificação facial e apoio à segurança pública.",
      "Desenvolver uma aplicação para detecção e rastreamento de chapas de aço em processos siderúrgicos.",
      "Implementar um sistema de acessibilidade integrado à educação para pessoas com dificuldade de locomoção.",
      "Desenvolver tecnologias de sensores para dispositivos e aplicações de Internet das Coisas e tecnologias assistivas.",
      "Criar um sistema de notificação e captação de órgãos para otimizar o processo de doação de órgãos."
    ]
  },
