{
  "codigo": "PJ 7965",
  "titulo": "Desenvolvimento de um sistema inteligente para o controle de eletrodos de fornos de ferroligas para aplicações multicliente",
  "descricao": "Projeto que visa desenvolver um sistema inteligente para orientar operadores sobre o deslizamento de eletrodos em fornos de ferroligas, melhorando a eficiência energética, segurança e produtividade, além de validar o sistema em até dois produtores de ferroligas no Brasil ou exterior. O projeto é apoiado pela FINEP, GainTech e Vamtec.",
  "palavras_chave": [
    "Ferroligas",
    "fornos elétricos",
    "eficiência energética",
    "eletrodos",
    "inteligência artificial"
  ],
  "area_conhecimento": "Engenharia Elétrica e Automação",
  "linha_pesquisa": "Inteligência Artificial",
  "objetivos": {
    "geral": "Desenvolver um sistema inteligente que oriente os procedimentos de deslizamento aos operadores de fornos elétricos, de forma que torne o processo mais eficiente.",
    "especificos": [
      "Realizar estudo detalhado do processo e revisão bibliográfica sobre o Sistema de Controle de Nível de Eletrodo (SCNE).",
      "Coletar dados de diferentes clientes para alimentar o desenvolvimento do modelo operacional.",
      "Desenvolver e implementar o sistema inteligente em ambientes de teste.",
      "Validar o sistema em operações reais, avaliando ganho de produtividade e eficácia.",
      "Elaborar o relatório final com conclusões dos testes e documentação do projeto."
    ]
  },
