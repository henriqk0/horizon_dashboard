  "codigo": "PJ 5678",
  "titulo": "Aplicação de Métodos de Otimização a Problemas existentes no Parque Industrial da Região Metropolitana de Vitória",
  "descricao": "Projeto de pesquisa que visa aplicar e desenvolver métodos de otimização para problemas reais enfrentados por empresas da região metropolitana do Espírito Santo, visando a modernização e eficiência industrial na indústria 4.0.",
  "palavras_chave": [
    "Otimização",
    "Indústria 4.0",
    "Modelos de programação matemática",
    "Métodos heurísticos",
    "Logística industrial",
    "Pesquisa operacional",
    "Engenharia de produção"
  ],
  "area_conhecimento": "Engenharia de Produção",
  "linha_pesquisa": "Pesquisa Operacional e Otimização",
  "objetivos": {
    "geral": "Desenvolver ferramentas computacionais para auxiliar empresas da Região Metropolitana de Vitória a resolverem problemas de otimização que surgem em suas cadeias produtivas.",
    "especificos": [
      "Fazer levantamento das restrições, características e dados necessários para a tomada de decisão em problemas de otimização.",
      "Investigar métodos de otimização que melhor se adaptem às características dos problemas enfrentados pelas empresas.",
      "Propor modelos de otimização exatos (programação linear/inteira) para obter soluções otimizadas.",
      "Desenvolver métodos heurísticos para obtenção de soluções de boa qualidade em tempo computacional viável.",
      "Validar as soluções obtidas por meio de modelos exatos e heurísticos.",
      "Publicar resultados em eventos e periódicos científicos.",
      "Transferir tecnologia para as empresas envolvidas."
    ]
  },
