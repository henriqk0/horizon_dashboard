{
  "codigo": "PJ 4874",
  "titulo": "Levantamento das referências culturais de São José do Queimado, Serra/ES",
  "descricao": "Projeto de pesquisa que visa documentar a memória da Insurreição de Queimado, analisar os riscos para sua continuidade e criar subsídios para o reconhecimento do Sítio Histórico e Arqueológico de Queimado (SHAQ) enquanto bem cultural, especialmente no que diz respeito ao Patrimônio Cultural Imaterial Nacional. O projeto envolve levantamento de referências culturais, mobilização da base social, produção de relatórios e materiais audiovisuais, além de ações pedagógicas e de extensão em parceria com o Iphan, escolas e movimentos sociais.",
  "palavras_chave": [
    "Patrimônio Cultural Imaterial",
    "Insurreição de Queimado",
    "Memória Afro-Capixaba",
    "Sítio Histórico e Arqueológico de Queimado",
    "Etnografia",
    "Movimentos Sociais",
    "Educação Patrimonial",
    "Resistência Negra",
    "Turismo de Base Comunitária",
    "Cultura Popular",
    "Relações Étnico-Raciais"
  ],
  "area_conhecimento": "Ciências Humanas e Sociais Aplicadas",
  "linha_pesquisa": "Estudos sobre Patrimônio Cultural, Memória Afro-Brasileira e Educação Patrimonial",
  "objetivos": {
    "geral": "Documentar a memória da Insurreição de Queimado e analisar os riscos para sua continuidade, contribuindo para o reconhecimento do SHAQ como bem cultural imaterial, além de promover a educação patrimonial e a mobilização da base social envolvida.",
    "especificos": [
      "Investigar as bases sociais, políticas e ideológicas que impulsionaram o pedido de tombamento do SHAQ pelo Legislativo Federal ao Iphan.",
      "Identificar e descrever elementos que caracterizam a relevância das referências culturais sobre a memória da Insurreição de Queimado em nível nacional.",
      "Compreender o sentido das aspirações de diferentes atores sociais sobre os usos do SHAQ enquanto lugar de memória.",
      "Produzir relatórios parciais e um dossiê de registro conforme a Resolução 001/2006 do Iphan.",
      "Criar obras audiovisuais que documentem a narrativa e os elementos culturais do SHAQ.",
      "Promover práticas pedagógicas e formação de professores para a educação patrimonial e relações étnico-raciais.",
      "Desenvolver estratégias para o turismo de base comunitária e pedagógica no SHAQ."
    ]
  },
