  "codigo": "PJ 4874",
  "titulo": "Levantamento das referências culturais de São José do Queimado, Serra/ES",
  "descricao": "Projeto de pesquisa que visa documentar a memória da Insurreição de Queimado, analisar os riscos para sua continuidade e criar subsídios para o reconhecimento do Sítio Histórico e Arqueológico de Queimado (SHAQ) como bem cultural em nível federal, além de promover a mobilização da base social envolvida.",
  "palavras_chave": [
    "memória cultural",
    "Insurreição de Queimado",
    "patrimônio imaterial",
    "escravidão negra",
    "movimentos sociais",
    "educação patrimonial",
    "Sítio Histórico e Arqueológico de Queimado",
    "reconhecimento cultural",
    "resistência afro-brasileira",
    "educação para relações étnico-raciais"
  ],
  "area_conhecimento": "Ciências Humanas e Sociais",
  "linha_pesquisa": "Estudos sobre patrimônio cultural, memória histórica e resistência afro-brasileira",
  "objetivos": {
    "geral": "Contribuir para a identificação precisa e mobilização da base social durante a execução de um plano de pesquisa, documentando a memória da Insurreição de Queimado e analisando os riscos para sua continuidade, além de criar subsídios para o reconhecimento do SHAQ como bem cultural em nível federal.",
    "especificos": [
      "Investigar as bases sociais, políticas e ideológicas que impulsionaram o pedido de tombamento do SHAQ feito pelo Legislativo Federal ao Iphan.",
      "Identificar e descrever os elementos que caracterizam a relevância das referências culturais sobre a memória da Insurreição de Queimado em nível nacional.",
      "Compreender o sentido das aspirações de diferentes atores sociais sobre os usos do SHAQ enquanto lugar de memória."
    ]
  },
